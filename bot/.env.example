# Não precisa copiar: na primeira vez o bot pergunta token e webhook e cria o .env
# sozinho. Aqui fica só o formato. O .env nunca vai pro git.

# Discord Developer Portal → sua aplicação → Bot → Reset Token.
DISCORD_TOKEN=

# O mesmo webhook colado no app, em Música → Canal do bot. O bot só obedece
# mensagens desse webhook; o resto do canal ele ignora.
WEBHOOK_URL=

# Opcional. Se o YouTube pedir "confirme que não é um robô", use os cookies do
# navegador em que você está logado no YouTube:
# YTDLP_ARGS=--cookies-from-browser chrome
