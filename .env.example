# Canal da mesa: as rolagens saem aqui. O app já abre apontando pra ele.
# Copie este arquivo para .env.local (que o git ignora) e ponha as URLs reais.
# Em produção os valores vêm dos secrets, injetados no build pelo workflow.
VITE_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN

# Canal só do mestre: cada personagem ocupa uma mensagem que se reescreve
# sozinha conforme a ficha muda. Deixe vazio pra desligar a ficha viva.
VITE_GM_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
